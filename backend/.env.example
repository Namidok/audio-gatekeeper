# Copy to backend/.env and fill in. Never commit backend/.env.
# Every setting is optional except the bucket; defaults are in app/config.py.

# ---------- Storage (AWS S3 or Cloudflare R2) ----------
S3_BUCKET=my-audio-bucket
S3_REGION=eu-central-1
# Leave both empty to use an IAM role / instance profile instead of static keys (recommended)
S3_ACCESS_KEY_ID=your-key-here
S3_SECRET_ACCESS_KEY=your-secret-here
# For Cloudflare R2 only:
# S3_ENDPOINT_URL=https://<ACCOUNT_ID>.r2.cloudflarestorage.com
# S3_REGION=auto

# ---------- Redis (jobs in db 0, Celery queue in db 1) ----------
# REDIS_URL=redis://localhost:6379/0
# Managed Redis with TLS: rediss://:password@host:6380/0?ssl_cert_reqs=required

# ---------- Compute ----------
# auto | cuda | mps | cpu
COMPUTE_DEVICE=auto
# AI bandwidth extension needs AudioSR (separate GPU worker) and a CUDA GPU
# ENABLE_AUDIOSR=true
# GPU_QUEUE_ENABLED=false     # true: send AI-upsampling jobs to the "gpu" Celery queue
# WORKER_ROLE=cpu             # gpu on the AudioSR worker

# ---------- Mastering ----------
# spotify | youtube | preserve | custom
# LOUDNESS_PROFILE=spotify
# TARGET_LUFS=-14             # custom profile only
# TRUE_PEAK_CEILING_DBTP=-1   # custom profile only

# ---------- Limits ----------
# MAX_UPLOAD_BYTES=209715200
# MAX_DURATION_SECONDS=1200
# JOB_SOFT_TIME_LIMIT_SECONDS=1680
# JOB_TIME_LIMIT_SECONDS=1800

# ---------- Web API ----------
# CORS_ORIGINS=["http://localhost:3000"]
# RATE_LIMIT_PER_MINUTE=30     # per client IP on POST/DELETE; 0 = off
# API_KEY=                     # set for server-to-server integrations; requires header X-API-Key
# TRUST_PROXY_HEADERS=false    # true only behind your own reverse proxy
# ENABLE_DOCS=true             # false in production
