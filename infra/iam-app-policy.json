{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "AudioGatekeeperObjects",
      "Effect": "Allow",
      "Action": ["s3:GetObject", "s3:PutObject", "s3:DeleteObject"],
      "Resource": [
        "arn:aws:s3:::YOUR-BUCKET-NAME/uploads/*",
        "arn:aws:s3:::YOUR-BUCKET-NAME/outputs/*"
      ]
    },
    {
      "Sid": "HeadBucketAndMissingKeysAs404",
      "Effect": "Allow",
      "Action": ["s3:ListBucket"],
      "Resource": "arn:aws:s3:::YOUR-BUCKET-NAME",
      "Condition": { "StringLike": { "s3:prefix": ["uploads/*", "outputs/*"] } }
    }
  ]
}
